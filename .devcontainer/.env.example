# .env.example — copy this file to .env and set your own password
#
# This file is safe to commit to git.
# The .env file (your actual secrets) must NOT be committed.
#
# How to use:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env and set a strong password
#   3. The docker-compose.yml reads SA_PASSWORD from .env automatically
#
# Password rules for SQL Server sa account:
#   - At least 8 characters
#   - Must include uppercase, lowercase, number, and special character

SA_PASSWORD=YourStrong!Passw0rd
